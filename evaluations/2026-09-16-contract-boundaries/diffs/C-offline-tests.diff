+ assert.throws(()=>reconcileFixedSpec({spec:{bodyLength:{...budget,min:130}}}),/冲突/);
+ assert.throws(()=>reconcileFixedSpec({constraints:['正文80到120字'],spec:{bodyLength:{...budget,max:99}}}),/不一致/);
