    {
      "type": "function",
      "name": "save_document",
      "description": "需要独立文稿或版本才保存，不要求先测字数。新稿传content；已有资产修订用parentId+parentVersion，不重抄父稿，但先确认完整原文可用；聊天原稿用parentMessageId+sourceText准确作品片段。sourceMessageId仅存档。通过requirements验收的作品传measurementCallId，content等于该次完整text；普通计数没有验收凭证。核对回执parentEvidence实际父稿，不只信标题。 局部修改用edits替代content，绑定父版本；先读取原文，不重写未改部分。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500000
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "parentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "sourceMessageId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "parentMessageId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "sourceText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500000
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "uniqueItems": true,
            "maxItems": 20
          },
          "parentVersion": {
            "type": "integer",
            "minimum": 1
          },
          "measurementCallId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "仅绑定deliveryCheck.status=passed的验收回执，content必须等于该次完整text。普通计数不属于验收，不需要本字段；保存动作本身不要求先测字数。"
          },
          "edits": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "before": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500000
                },
                "after": {
                  "type": "string",
                  "maxLength": 500000
                }
              },
              "required": [
                "before",
                "after"
              ]
            }
          }
        },
        "required": [],
