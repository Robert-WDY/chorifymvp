                "minLength": 1,
                "maxLength": 120
              }
            },
            "required": [
              "kind"
            ]
          },
          "assetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "assetVersion": {
            "type": "integer",
            "minimum": 1
          },
