                "minLength": 1,
                "maxLength": 200
              },
              "messageId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30000
              },
              "reason": {
