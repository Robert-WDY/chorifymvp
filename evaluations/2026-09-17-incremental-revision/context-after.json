                "minLength": 1,
                "maxLength": 1000
              }
            },
            "required": [
              "callId",
              "messageId",
              "quote",
              "reason"
            ]
          }
        },
        "required": [
          "unit"
        ],
        "anyOf": [
          {
            "required": [
              "text"
            ]
          },
          {
            "required": [
              "assetId",
              "assetVersion"
            ]
          }
        ]
      },
      "strict": false
    },
