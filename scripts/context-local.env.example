# Copy to this checkout's .env.local; never commit credentials.
LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_EFFORT=none
DEEPSEEK_API_KEY=
CONTEXT_AGENT_ALLOW_MODEL=1
CONTEXT_AGENT_MAX_MODEL_CALLS=16
CONTEXT_AGENT_MAX_STEPS=16
CONTEXT_AGENT_ALLOW_MEDIA=0
CONTEXT_AGENT_MAX_MEDIA_CALLS=4
CONTEXT_AGENT_VISION_ENABLED=0
LLM_PARALLEL_TOOL_CALLS_SUPPORTED=0
LLM_TEXT_STREAMING_SUPPORTED=0
# Port 3217 and repository-local data are fixed by the isolated launcher.
