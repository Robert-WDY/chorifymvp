[
  {
    "name": "validate_style_preservation",
    "entrypoint": "scripts/validate-style-preservation.py",
    "description": "确定性检查风格改写是否保留指定原文、镜号、时码、画幅和生成参数，并报告常见技术冲突",
    "inputSchema": {
      "type": "object",
      "required": [
        "originalText",
        "optimizedText"
      ],
      "properties": {
        "originalText": {
          "type": "string",
          "maxLength": 200000,
          "minLength": 1
        },
        "optimizedText": {
          "type": "string",
          "maxLength": 200000,
          "minLength": 1
        },
        "lockedLiterals": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1
          },
          "default": [],
          "maxItems": 200
        },
        "checkTechnicalConflicts": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "required": [
        "valid",
        "readyToDeliver",
        "missingLockedLiterals",
        "protectedTokenDifferences",
        "conflicts",
        "warnings",
        "summary"
      ],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "summary": {
          "type": "object",
          "required": [
            "lockedLiteralCount",
            "protectedTokenCountOriginal",
            "protectedTokenCountOptimized"
          ],
          "properties": {
            "lockedLiteralCount": {
              "type": "integer",
              "minimum": 0
            },
            "protectedTokenCountOriginal": {
              "type": "integer",
              "minimum": 0
            },
            "protectedTokenCountOptimized": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "readyToDeliver": {
          "type": "boolean"
        },
        "missingLockedLiterals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "protectedTokenDifferences": {
          "type": "object",
          "required": [
            "missing",
            "added"
          ],
          "properties": {
            "added": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "missing": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
]