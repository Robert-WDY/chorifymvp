PORT=3210
LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_EFFORT=none
DEEPSEEK_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com
DOUBAO_CHAT_MODEL=doubao-seed-2-1-turbo-260628
DOUBAO_API_KEY=
DOUBAO_IMAGE_MODEL=doubao-seedream-4-0-250828
DOUBAO_VIDEO_MODEL=doubao-seedance-1-0-pro-250528
MAX_AGENT_STEPS=16
# Optional absolute Python path. Otherwise uses python from PATH.
PYTHON_BIN=
# Independent optional media services. No credentials are sent to the browser.
TTS_URL=
TTS_APP_ID=
TTS_ACCESS_KEY=
TTS_RESOURCE_ID=
TTS_DEFAULT_VOICE=
MEDIA_SERVICE_URL=
MEDIA_SERVICE_KEY=
REPLICATION_URL=
REPLICATION_KEY=
UPSCALE_URL=
UPSCALE_KEY=
UPSCALE_APP_ID=
UPSCALE_VIDEO_NODE=
UPSCALE_SIZE_NODE=
UPSCALE_INSTANCE_TYPE=
UPSCALE_PERSONAL_QUEUE=false
TRANSCODE_URL=
TRANSCODE_KEY=
VIDEO_ANALYSIS_URL=
VIDEO_ANALYSIS_TOKEN=
VIDEO_ANALYSIS_KEY=

# delivery_only: require all deliveries, skip model quality/constraint acceptance.
# strict: retain full content/visual acceptance for explicit evaluations.
RESULT_ACCEPTANCE=delivery_only

# Independent context-agent defaults; enabling real calls needs separate authorization.
CONTEXT_AGENT_ALLOW_MODEL=0
CONTEXT_AGENT_ALLOW_MEDIA=0
CONTEXT_AGENT_MAX_MODEL_CALLS=16
# Unset: simulation defaults to 4; live mode requires an explicitly approved positive budget.
# CONTEXT_AGENT_MAX_MEDIA_CALLS=4
CONTEXT_AGENT_SUMMARY_ENABLED=1
CONTEXT_AGENT_SUMMARY_TRIGGER=0.75
CONTEXT_AGENT_SUMMARY_TARGET=0.55
CONTEXT_AGENT_SUMMARY_TOKENS=1800
CONTEXT_AGENT_SUMMARY_INPUT_TOKENS=8000
CONTEXT_AGENT_SUMMARY_MAX_CALLS=2
CONTEXT_AGENT_SUMMARY_RESERVE_CALLS=2
CONTEXT_AGENT_CONTEXT_SAFETY_TOKENS=500
# Set to 1 only after confirming the selected Responses provider supports this option.
LLM_PARALLEL_TOOL_CALLS_SUPPORTED=0
# Only enable after verifying this endpoint/model's Responses SSE support.
# Public text deltas only; complete validated tool arguments still required.
LLM_TEXT_STREAMING_SUPPORTED=0
